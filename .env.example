# Backend: JSON object mapping each generated bearer key to its principal and scopes.
# Replace GENERATE_A_RANDOM_DEV_KEY with a unique key; this example is not a credential.
CONTROL_LAYER_API_KEYS='{"GENERATE_A_RANDOM_DEV_KEY":{"name":"local-operator","scopes":["evaluate","viewer","approver","admin"]}}'
CONTROL_LAYER_POLICY_PATH=../policies/example.policy.yaml
CONTROL_LAYER_DB_PATH=./control-layer.sqlite3
OPENAI_API_KEY=

# Dashboard server-side proxy target.
CONTROL_LAYER_BACKEND_URL=http://127.0.0.1:8000
